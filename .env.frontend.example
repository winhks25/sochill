# Vite client environment.
# Only variables prefixed with VITE_ are bundled into the client, so these are safe to
# expose publicly. This file documents the production values; copy it to
# `.env` / `.env.production` and fill in your deployed Supabase project.

# Public URL of the deployed Supabase project.
VITE_SUPABASE_URL="https://<your-project>.supabase.co"

# Public anon (publishable) key. Safe to ship in the browser build.
VITE_SUPABASE_ANON_KEY="<public anon key>"

# Do NOT add RESEND_API_KEY or the service/secret key here. They would be embedded in the
# browser bundle and expose email sending and privileged database access to any visitor.
