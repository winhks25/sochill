# Local Supabase development secrets.
# Used by `supabase start`, `supabase functions serve`, and functions running locally.
# NEVER expose these values to the browser and never put them in Vite environment variables.

# Local Supabase endpoint (from `supabase start` output).
SUPABASE_URL="http://localhost:54321"

# Local service/secret key (from `supabase start` output). Only required if a function
# needs elevated, non-RLS access locally.
SUPABASE_SERVICE_KEY=""

# Resend API key used to send confirmation emails. For local testing, set a key here or
# via `supabase functions serve --env .env`. At deploy time, pass it with
# `supabase functions deploy --secret "RESEND_API_KEY=<key>"` or store it in Vault.
RESEND_API_KEY=""
